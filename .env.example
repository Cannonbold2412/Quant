# Copy to `.env` (gitignored) and edit. Every setting is also expressible in
# `aqrl.toml` (without the AQRL_ prefix); environment variables win.
# No secrets belong in tracked files.

# ---------------------------------------------------------------------------
# Secrets — API keys (never commit the real .env)
# ---------------------------------------------------------------------------

# Anthropic key for the agent session wrapper (aqrl/agents/session.py) —
# drives A1–A5. Falls back to the standard ANTHROPIC_API_KEY env var.
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI key for embedding-cached relevance search (aqrl/agents/embeddings.py)
# and the Librarian's novelty scoring. Also read via Voyage's own VOYAGE_API_KEY.
AQRL_VOYAGE_API_KEY=vo-...

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------

# Model the agent session wrapper calls (A2 Quant Engineer et al.).
AQRL_ANTHROPIC_MODEL=claude-opus-5

# Embedding model is fixed in code (voyage-3.5); no override exists.

# ---------------------------------------------------------------------------
# Paths & storage
# ---------------------------------------------------------------------------

# Path to the SQLite metadata database (relative paths resolve against the repo root).
AQRL_DB_PATH=aqrl.db

# Root for the Parquet snapshot store. Backend-Schema §16: paths are stored in
# the database *relative* to this root, so local -> object storage is a config change.
AQRL_DATA_ROOT=data

# Directory holding market/, timeframes/ and costs/ profile YAML.
AQRL_PROFILES_DIR=profiles

# One git repo, one orphan branch per strategy (TRD §5.2). Never the framework repo.
AQRL_STRATEGY_REPO_PATH=strategy_repo

# Archived raw text of every collected external_documents row (Librarian, Stage 10).
AQRL_DOCUMENTS_ROOT=documents

# ---------------------------------------------------------------------------
# Logging (TRD §17)
# ---------------------------------------------------------------------------

AQRL_LOG_LEVEL=INFO
AQRL_LOG_FORMAT=json

# ---------------------------------------------------------------------------
# A2 Quant Engineer — iteration limits & sandbox (Stage 5)
# ---------------------------------------------------------------------------

# Bounded FIX_CODE retries on one experiment before quarantine.
AQRL_MAX_FIX_ATTEMPTS=3

# Wall-clock / CPU / memory caps for the static-check + smoke-run subprocess.
AQRL_SANDBOX_TIMEOUT_SECONDS=60
AQRL_SANDBOX_CPU_SECONDS=30
AQRL_SANDBOX_MEMORY_BYTES=3221225472

# ---------------------------------------------------------------------------
# The nervous system — job queue & scheduler (Stage 4)
# ---------------------------------------------------------------------------

# SQLite busy_timeout — how long a writer waits under contention (ms).
AQRL_BUSY_TIMEOUT_MS=5000

AQRL_SCHEDULER_TICK_SECONDS=60
AQRL_DEFAULT_LEASE_SECONDS=300
AQRL_MAX_CONCURRENT_WORKERS=4

# Consecutive job failures on one strategy before it is quarantined.
AQRL_QUARANTINE_AFTER_FAILURES=3

# ---------------------------------------------------------------------------
# Human gates (Stage 9)
# ---------------------------------------------------------------------------

# Lifetime vault opens per strategy family (TRD §15.2).
AQRL_VAULT_BUDGET_PER_FAMILY=1

# ---------------------------------------------------------------------------
# The Librarian (Stage 10)
# ---------------------------------------------------------------------------

AQRL_HTTP_TIMEOUT_SECONDS=15
AQRL_HTTP_USER_AGENT=aqrl-librarian/1.0 (research collector; contact: research@local)

# Minimum gap between requests to the same host (seconds).
AQRL_LIBRARIAN_MIN_REQUEST_INTERVAL_SECONDS=3

# Below this term-overlap score a document is stored 'irrelevant' and never extracted.
AQRL_LIBRARIAN_RELEVANCE_THRESHOLD=0.34

# Above this embedding-distance novelty score, HIGH_NOVELTY_EXTRACTION fires.
AQRL_LIBRARIAN_NOVELTY_THRESHOLD=0.5

# Cap on documents per COLLECT_PAPERS run / extraction calls per document.
AQRL_LIBRARIAN_MAX_DOCUMENTS_PER_RUN=20
AQRL_LIBRARIAN_MAX_CHUNKS_PER_DOCUMENT=12

# Broad-sweep search terms when the curiosity queue has no open questions.
AQRL_LIBRARIAN_BROAD_TERMS=["quantitative trading", "systematic strategy", "market anomaly"]

# Extra (source, feed_url) pairs FeedCollector polls; source in {ssrn, blog, journal}.
# AQRL_LIBRARIAN_FEEDS=[["blog", "https://example.com/feed.xml"]]

# ---------------------------------------------------------------------------
# Paper trading & health monitoring (Stage 11)
# ---------------------------------------------------------------------------

# Kill switch: cumulative loss / peak-to-trough drawdown as fractions of paper-era equity.
AQRL_RISK_MAX_LOSS_PCT=0.25
AQRL_RISK_MAX_DRAWDOWN_PCT=0.30

# Below this many paper trades, health defaults to green (too few observations).
AQRL_HEALTH_MIN_TRADES_FOR_VERDICT=20

# Health verdict thresholds: z-scores, KS p-value floor, slippage deviation (bps),
# and tripped-signal count that promotes yellow to orange (PRD §9.4).
AQRL_HEALTH_ZSCORE_YELLOW=-1.5
AQRL_HEALTH_ZSCORE_RED=-3.0
AQRL_HEALTH_LOSS_PVALUE=0.01
AQRL_HEALTH_SLIPPAGE_DEVIATION=2.0
AQRL_HEALTH_ORANGE_SIGNALS=2
