# Copy this file to `.env` or run `.\setup.ps1` to scaffold it automatically.
# For advanced fallback options, use the README.

GOOGLE_CREDENTIAL_DIR=credentials/google_drive
# Use `LLM_API_KEYS` to rotate requests across multiple OpenAI-compatible keys.
# Example: LLM_API_KEYS=sk-key-1,sk-key-2,sk-key-3,sk-key-4,sk-key-5
LLM_API_KEYS=
# Single-key fallback:
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
STRATEGY_TARGET_MIN=50
STRATEGY_TARGET_MAX=100
BACKTEST_JOBS_FILE=backtest_jobs.example.json
